{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["kustomize"],
  "includePaths": ["local-kubernetes/manifests/docsight/kustomization.yaml"],
  "packageRules": [
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/kahlstrm/docsight"],
      "pinDigests": true,
      "automerge": false,
      "groupName": "DOCSight image"
    }
  ]
}
